# Kopieren nach .env und anpassen
POSTGRES_PASSWORD=bitte-durch-ein-langes-zufaelliges-kennwort-ersetzen
PORT=3000

# Name und Benutzer der Datenbank (Standard: vibeboard)
#POSTGRES_DB=vibeboard
#POSTGRES_USER=vibeboard

# Optional: Administrator automatisch anlegen (sonst wird die erste Registrierung Admin)
#ADMIN_USERNAME=admin
#ADMIN_PASSWORD=ein-langes-sicheres-kennwort
#ADMIN_EMAIL=admin@example.org

# Öffentliche Adresse für Links in E-Mails, z. B. https://board.example.de
#PUBLIC_URL=

# Hinter einem Reverse-Proxy (nginx, Caddy, Traefik)
#TRUST_PROXY=1

# Virenscanner: Standard ist der mitgestartete ClamAV-Dienst. Leer setzen, um ohne Scanner zu arbeiten
# (dann sind Uploads gesperrt, solange „Uploads ohne Virenscanner sperren“ in der Administration aktiv ist).
#CLAMAV_HOST=clamav

# Anzahl der aufbewahrten Sicherungen vor Upgrades
#BACKUP_KEEP=10

# Protokollierung: Stufe trace | debug | info | warn | error | fatal | silent (Standard info; in der Administration
# zur Laufzeit änderbar) und Format text (lesbar) oder json (eine JSON-Zeile je Eintrag, für Log-Sammelsysteme)
#LOG_LEVEL=info
#LOG_FORMAT=text
