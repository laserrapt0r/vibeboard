# Kopieren nach .env und anpassen
POSTGRES_PASSWORD=bitte-aendern
PORT=3000

# Optional: Administrator automatisch anlegen (sonst wird die erste Registrierung Admin)
#ADMIN_USERNAME=admin
#ADMIN_PASSWORD=ein-sicheres-kennwort
#ADMIN_EMAIL=admin@example.org

# Öffentliche Adresse für Links in E-Mails, z. B. https://board.example.de
#PUBLIC_URL=

# Hinter einem Reverse-Proxy (nginx, Caddy, Traefik)
#TRUST_PROXY=1
