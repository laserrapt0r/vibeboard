{
  "name": "vibeboard",
  "version": "4.19.0",
  "description": "Kollaboratives Online-Whiteboard mit Echtzeit-Zusammenarbeit, Vorlagen, Benutzerverwaltung und PostgreSQL",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "check": "node --check server.js",
    "test:upgrade": "node scripts/test-upgrade.js",
    "test:access": "node scripts/test-access.js",
    "test:sync": "node scripts/test-sync.js",
    "test:formula": "node scripts/test-formula.js",
    "test:text": "node scripts/test-text.js",
    "test:robust": "node scripts/test-robust.js",
    "test:svg": "node scripts/test-svg.js",
    "test:browser": "node scripts/browser/run.js",
    "test:load": "node scripts/load-test.js",
    "check:i18n": "node scripts/check-i18n.js",
    "check:dom": "node scripts/check-dom.js",
    "build:icons": "node scripts/build-icons.js",
    "build:symbols": "node scripts/build-symbols.js"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "(MIT AND CC-BY-SA-3.0 AND Apache-2.0)",
  "private": true,
  "dependencies": {
    "@node-saml/node-saml": "5.2.0",
    "@xmldom/xmldom": "0.9.12",
    "ldapts": "9.2.0",
    "nodemailer": "^10.2.1",
    "pdfjs-dist": "^6.4.299",
    "pg": "^8.23.1",
    "uqr": "^0.1.3"
  },
  "devDependencies": {
    "@tabler/icons": "3.50.0",
    "acorn": "^8.19.0",
    "acorn-walk": "^8.3.5",
    "puppeteer-core": "^25.16.0"
  },
  "optionalDependencies": {
    "kerberos": "7.0.0"
  }
}
